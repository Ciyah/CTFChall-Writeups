<div class="animate-fade-in">
    <!-- Two Column Layout: Welcome Card + Stats Sidebar -->
    <div class="mb-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Column: Welcome Card -->
        <div class="lg:col-span-8">
            <div
                class="overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 p-6 text-white shadow-xl sm:rounded-3xl sm:p-8 h-full"
            >
                <div class="flex items-start gap-4">
                    <div
                        class="flex h-16 w-16 flex-shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/20 backdrop-blur-sm border-2 border-white/30"
                    >
                        <% if (user.avatar) { %>
                        <img
                            src="<%= user.avatar %>"
                            alt="<%= user.displayName %>"
                            class="h-full w-full object-cover"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                        />
                        <span class="iconify h-8 w-8" data-icon="ph:student-bold" style="display: none"></span>
                        <% } else { %>
                        <span class="iconify h-8 w-8" data-icon="ph:student-bold"></span>
                        <% } %>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h1 class="text-2xl font-bold sm:text-3xl break-words">Welcome, <%= user.displayName %>!</h1>
                        <p class="text-indigo-100 mt-1 text-sm sm:text-base">
                            Complete your assignments and track your progress
                        </p>
                        <% if (user.bio) { %>
                        <p class="text-indigo-200 mt-2 text-sm leading-relaxed">
                            <%= user.bio.substring(0, 100) %> <%= user.bio.length > 100 ? '...' : '' %>
                        </p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Statistics Card -->
        <div class="lg:col-span-4">
            <div class="overflow-hidden rounded-2xl bg-white shadow-xl sm:rounded-3xl h-full">
                <div class="bg-gradient-to-br from-indigo-50 to-purple-50 p-4 border-b border-indigo-100">
                    <h3 class="text-sm font-bold text-indigo-900 uppercase tracking-wide flex items-center gap-2">
                        <span class="iconify h-5 w-5" data-icon="ph:chart-line-bold"></span>
                        YOUR STATISTICS
                    </h3>
                </div>
                <div class="p-4">
                    <div id="user-stats" class="flex flex-col gap-3"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Assignment Form (Teachers Only) -->
    <% if (user.role==='teacher' ) { %>
    <form action="/assignment" method="POST" class="mb-8">
        <div class="overflow-hidden rounded-2xl bg-white shadow-card sm:rounded-3xl">
            <div class="border-b border-slate-100 bg-slate-50/80 p-5 backdrop-blur">
                <h2 class="text-lg font-bold text-slate-900">
                    <span class="iconify mr-2 inline-block h-5 w-5" data-icon="ph:pencil-bold"></span>
                    Create a New Assignment
                </h2>
            </div>
            <div class="p-6">
                <textarea
                    name="content"
                    placeholder="Assignment description... (You can use HTML tags: img, h3, p, strong, ul, li, etc.)"
                    class="mb-4 block w-full rounded-xl border border-slate-200 bg-slate-50 p-4 text-base text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all"
                    rows="4"
                    required
                ></textarea>
                <div class="flex items-center justify-between gap-4">
                    <label class="flex items-center gap-2 cursor-pointer group">
                        <input
                            class="h-5 w-5 rounded border-slate-300 text-indigo-600 focus:ring-2 focus:ring-indigo-100 focus:ring-offset-0 transition-all"
                            type="checkbox"
                            name="isPrivate"
                            id="isPrivate"
                        />
                        <span class="text-sm font-medium text-slate-600 group-hover:text-slate-900 transition-colors">
                            <span class="iconify mr-1 inline-block h-4 w-4" data-icon="ph:lock-bold"></span>
                            Make this assignment private
                        </span>
                    </label>
                    <button
                        type="submit"
                        class="rounded-xl bg-indigo-600 px-6 py-3 font-bold text-white shadow-lg shadow-indigo-600/20 transition-all hover:bg-indigo-700 active:scale-95"
                    >
                        <span class="iconify mr-2 inline-block h-5 w-5" data-icon="ph:paper-plane-right-bold"></span>
                        Create Assignment
                    </button>
                </div>
            </div>
        </div>
    </form>
    <% } %>

    <!-- Assignments Feed -->
    <div class="space-y-6">
        <div class="flex items-center justify-between gap-4 flex-wrap">
            <h2 class="text-xl font-bold text-slate-900">
                <span class="iconify mr-2 inline-block h-6 w-6" data-icon="ph:books-bold"></span>
                Available Assignments
            </h2>
            <div class="flex items-center gap-3">
                <div class="relative">
                    <input
                        type="text"
                        id="searchAssignments"
                        placeholder="Search assignments..."
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2 pl-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
                    />
                    <span
                        class="iconify absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                        data-icon="ph:magnifying-glass-bold"
                    ></span>
                </div>
                <button id="viewModeBtn" onclick="toggleViewMode()" class="feature-btn" title="Toggle view mode">
                    <span class="iconify h-5 w-5" data-icon="ph:grid-four-bold"></span>
                </button>
            </div>
        </div>

        <% if (assignments.length===0) { %>
        <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-12 text-center sm:rounded-3xl">
            <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400"
            >
                <span class="iconify h-8 w-8" data-icon="ph:book-open-bold"></span>
            </div>
            <h3 class="mb-2 text-lg font-bold text-slate-900">No assignments yet</h3>
            <p class="text-slate-600">Create the first assignment to get started!</p>
        </div>
        <% } %>

        <div class="assignments-container space-y-6">
            <% assignments.forEach(assignment=> { const userHasSubmitted = submissions.some(s => s.assignmentId ===
            assignment.id && s.author.email === user.email); %>
            <div
                class="assignment-card overflow-hidden rounded-2xl bg-white shadow-card sm:rounded-3xl"
                data-assignment-id="<%= assignment.id %>"
            >
                <div class="p-6">
                    <div class="mb-4 flex items-start justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div
                                class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-indigo-100 text-indigo-600"
                            >
                                <% if (assignment.author.avatar) { %>
                                <img
                                    src="<%= assignment.author.avatar %>"
                                    alt="<%= assignment.author.name %>"
                                    class="h-full w-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                />
                                <span
                                    class="iconify h-5 w-5"
                                    data-icon="ph:chalkboard-teacher-bold"
                                    style="display: none"
                                ></span>
                                <% } else { %>
                                <span class="iconify h-5 w-5" data-icon="ph:chalkboard-teacher-bold"></span>
                                <% } %>
                            </div>
                            <div>
                                <p class="font-semibold text-slate-900"><%= assignment.author.name %></p>
                                <div class="assignment-meta flex items-center gap-2">
                                    <p class="text-xs text-slate-500">
                                        <%= new Date(assignment.timestamp).toLocaleString() %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <% if (userHasSubmitted) { %>
                            <span
                                class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-600"
                            >
                                <span class="iconify h-3 w-3" data-icon="ph:check-bold"></span>
                                Submitted
                            </span>
                            <% } %> <% if (assignment.isPrivate) { %>
                            <span
                                class="badge-private inline-flex items-center gap-1 rounded-full bg-rose-100 px-3 py-1 text-xs font-bold text-rose-600"
                            >
                                <span class="iconify h-3 w-3" data-icon="ph:lock-bold"></span>
                                Private
                            </span>
                            <% } else { %>
                            <span
                                class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-600"
                            >
                                <span class="iconify h-3 w-3" data-icon="ph:globe-bold"></span>
                                Public
                            </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="assignment-content mb-4 text-slate-700"><%- assignment.content %></div>

                    <!-- Reaction Buttons -->
                    <div class="mb-4 flex items-center gap-2 border-t border-slate-100 pt-4">
                        <button class="reaction-btn" onclick="addReaction('<%= assignment.id %>', '👍')" title="Like">
                            👍
                        </button>
                        <button class="reaction-btn" onclick="addReaction('<%= assignment.id %>', '❤️')" title="Love">
                            ❤️
                        </button>
                        <button
                            class="reaction-btn"
                            onclick="addReaction('<%= assignment.id %>', '🤔')"
                            title="Thinking"
                        >
                            🤔
                        </button>
                        <button
                            class="reaction-btn"
                            onclick="addReaction('<%= assignment.id %>', '🎯')"
                            title="On Point"
                        >
                            🎯
                        </button>
                        <button class="reaction-btn" onclick="addReaction('<%= assignment.id %>', '🔥')" title="Fire">
                            🔥
                        </button>
                        <div id="reactions-<%= assignment.id %>" class="ml-auto flex items-center gap-2"></div>
                    </div>

                    <div class="flex items-center justify-between gap-4">
                        <div class="flex items-center gap-2">
                            <button
                                class="bookmark-btn"
                                data-item-id="<%= assignment.id %>"
                                onclick="toggleBookmark('<%= assignment.id %>')"
                                title="Bookmark"
                            >
                                <span class="iconify h-4 w-4" data-icon="ph:bookmark-simple-bold"></span>
                            </button>
                            <button
                                onclick="copyAssignmentLink('<%= assignment.id %>')"
                                class="inline-flex items-center gap-1 text-xs text-slate-500 hover:text-indigo-600"
                                title="Copy link"
                            >
                                <span class="iconify h-4 w-4" data-icon="ph:link-bold"></span>
                            </button>
                        </div>
                        <a
                            href="/assignment/<%= assignment.id %>"
                            class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition-all hover:bg-indigo-700 active:scale-95"
                        >
                            <% if (userHasSubmitted) { %> View Submissions <% } else { %> Submit Assignment <% } %>
                            <span class="iconify h-4 w-4" data-icon="ph:arrow-right-bold"></span>
                        </a>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>

        <!-- No Search Results Message -->
        <div
            id="no-search-results"
            class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-12 text-center sm:rounded-3xl"
        >
            <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400"
            >
                <span class="iconify h-8 w-8" data-icon="ph:magnifying-glass-bold"></span>
            </div>
            <h3 class="mb-2 text-lg font-bold text-slate-900">No assignments found</h3>
            <p class="text-slate-600">Try adjusting your search terms</p>
        </div>
    </div>
</div>
