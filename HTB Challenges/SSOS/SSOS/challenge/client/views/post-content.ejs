<div class="animate-fade-in mx-auto max-w-4xl">
    <!-- Back Button -->
    <div class="mb-6">
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-card transition-all hover:bg-slate-50 active:scale-95">
            <span class="iconify h-4 w-4" data-icon="ph:arrow-left-bold"></span>
            Back to Home
        </a>
    </div>

    <!-- Post Card -->
    <div class="overflow-hidden rounded-2xl bg-white shadow-card sm:rounded-3xl">
        <div class="border-b border-slate-100 bg-slate-50/80 p-5 backdrop-blur sm:p-6">
            <div class="flex items-center justify-between gap-4">
                <h1 class="text-xl font-bold text-slate-900 sm:text-2xl">
                    <span class="iconify mr-2 inline-block h-6 w-6" data-icon="ph:article-bold"></span>
                    Post Details
                </h1>
                <% if (post.isPrivate) { %>
                    <span class="badge-private inline-flex items-center gap-1 rounded-full bg-rose-100 px-3 py-1.5 text-xs font-bold text-rose-600">
                        <span class="iconify h-4 w-4" data-icon="ph:lock-bold"></span>
                        Private
                    </span>
                <% } else { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-bold text-emerald-600">
                        <span class="iconify h-4 w-4" data-icon="ph:globe-bold"></span>
                        Public
                    </span>
                <% } %>
            </div>
        </div>

        <div class="p-6 sm:p-8">
            <!-- Author Info -->
            <div class="mb-6 flex items-center justify-between gap-4 rounded-xl bg-slate-50 p-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-indigo-100 text-indigo-600">
                        <% if (post.author.avatar) { %>
                            <img src="<%= post.author.avatar %>" alt="<%= post.author.name %>" class="h-full w-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                            <span class="iconify h-6 w-6" data-icon="ph:user-bold" style="display:none;"></span>
                        <% } else { %>
                            <span class="iconify h-6 w-6" data-icon="ph:user-bold"></span>
                        <% } %>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-900"><%= post.author.name %></p>
                        <p class="text-sm text-slate-500">
                            <span class="iconify mr-1 inline-block h-4 w-4" data-icon="ph:clock-bold"></span>
                            <%= new Date(post.timestamp).toLocaleString() %>
                        </p>
                    </div>
                </div>
                <div id="post-stats-<%= post.id %>" class="flex gap-3 text-sm"></div>
            </div>

            <!-- Post Content -->
            <div class="post-content prose prose-slate max-w-none rounded-xl bg-gradient-to-br from-slate-50 to-white p-6 text-slate-800 sm:p-8">
                <%- post.content %>
            </div>
            
            <!-- Interaction Buttons -->
            <div class="mt-6 flex items-center justify-between gap-4 rounded-xl bg-slate-50 p-4">
                <div class="flex items-center gap-2">
                    <button class="reaction-btn" onclick="addReaction('<%= post.id %>', '👍')" title="Like">👍</button>
                    <button class="reaction-btn" onclick="addReaction('<%= post.id %>', '❤️')" title="Love">❤️</button>
                    <button class="reaction-btn" onclick="addReaction('<%= post.id %>', '😂')" title="Haha">😂</button>
                    <button class="reaction-btn" onclick="addReaction('<%= post.id %>', '🤔')" title="Thinking">🤔</button>
                    <button class="reaction-btn" onclick="addReaction('<%= post.id %>', '🎉')" title="Celebrate">🎉</button>
                </div>
                <div class="flex items-center gap-3">
                    <button class="bookmark-btn" data-post-id="<%= post.id %>" onclick="toggleBookmark('<%= post.id %>')" title="Bookmark">
                        <span class="iconify h-5 w-5" data-icon="ph:bookmark-simple-bold"></span>
                    </button>
                    <button onclick="copyPostLink('<%= post.id %>')" class="inline-flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition-all hover:bg-slate-100" title="Copy link">
                        <span class="iconify h-4 w-4" data-icon="ph:link-bold"></span>
                        Copy Link
                    </button>
                </div>
            </div>
            
            <div id="reactions-<%= post.id %>" class="mt-4 flex flex-wrap items-center gap-2" data-post-id="<%= post.id %>"></div>
        </div>
    </div>
</div>

<script src="/js/app.js"></script>
<script>
// Load post stats on detail page
document.addEventListener('DOMContentLoaded', async function() {
    const postId = '<%= post.id %>';
    try {
        const response = await fetch(`/api/stats/${postId}`);
        const stats = await response.json();
        
        const statsContainer = document.getElementById(`post-stats-${postId}`);
        if (statsContainer) {
            statsContainer.innerHTML = `
                <div class="stat-item">
                    <span class="iconify h-4 w-4" data-icon="ph:eye-bold"></span>
                    <span class="stat-number">${stats.views}</span>
                </div>
                <div class="stat-item">
                    <span class="iconify h-4 w-4" data-icon="ph:smiley-bold"></span>
                    <span class="stat-number">${stats.totalReactions}</span>
                </div>
            `;
        }
    } catch (error) {
        console.error('Failed to load post stats:', error);
    }
});
</script> 