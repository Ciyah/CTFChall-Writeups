<div class="animate-fade-in mx-auto max-w-4xl">
    <!-- Back Button -->
    <div class="mb-6">
        <a href="/"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-card transition-all hover:bg-slate-50 active:scale-95">
            <span class="iconify h-4 w-4" data-icon="ph:arrow-left-bold"></span>
            Back to Assignments
        </a>
    </div>

    <!-- Assignment Card -->
    <div class="overflow-hidden rounded-2xl bg-white shadow-card sm:rounded-3xl">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-500 to-purple-600 p-5 backdrop-blur sm:p-6">
            <div class="flex items-center justify-between gap-4">
                <h1 class="text-xl font-bold text-white sm:text-2xl">
                    <span class="iconify mr-2 inline-block h-6 w-6" data-icon="ph:book-open-bold"></span>
                    Assignment Details
                </h1>
                <% if (assignment.isPrivate) { %>
                    <span
                        class="inline-flex items-center gap-1 rounded-full bg-white/20 backdrop-blur px-3 py-1.5 text-xs font-bold text-white border border-white/30">
                        <span class="iconify h-4 w-4" data-icon="ph:lock-bold"></span>
                        Private
                    </span>
                    <% } else { %>
                        <span
                            class="inline-flex items-center gap-1 rounded-full bg-white/20 backdrop-blur px-3 py-1.5 text-xs font-bold text-white border border-white/30">
                            <span class="iconify h-4 w-4" data-icon="ph:globe-bold"></span>
                            Public
                        </span>
                        <% } %>
            </div>
        </div>

        <div class="p-6 sm:p-8">
            <!-- Instructor Info -->
            <div class="mb-6 flex items-center justify-between gap-4 rounded-xl bg-slate-50 p-4">
                <div class="flex items-center gap-3">
                    <div
                        class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-indigo-100 text-indigo-600">
                        <% if (assignment.author.avatar) { %>
                            <img src="<%= assignment.author.avatar %>" alt="<%= assignment.author.name %>"
                                class="h-full w-full object-cover"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                            <span class="iconify h-6 w-6" data-icon="ph:chalkboard-teacher-bold"
                                style="display:none;"></span>
                            <% } else { %>
                                <span class="iconify h-6 w-6" data-icon="ph:chalkboard-teacher-bold"></span>
                                <% } %>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500">Instructor</p>
                        <p class="font-semibold text-slate-900">
                            <%= assignment.author.name %>
                        </p>
                        <p class="text-xs text-slate-500">
                            <span class="iconify mr-1 inline-block h-4 w-4" data-icon="ph:clock-bold"></span>
                            <%= new Date(assignment.timestamp).toLocaleString() %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Assignment Content -->
            <div class="mb-6 rounded-xl bg-gradient-to-br from-slate-50 to-white p-6 sm:p-8">
                <h2 class="mb-4 text-lg font-bold text-slate-900">
                    <span class="iconify mr-2 inline-block h-5 w-5" data-icon="ph:file-text-bold"></span>
                    Assignment Description
                </h2>
                <div class="assignment-content prose prose-slate max-w-none text-slate-800">
                    <%- assignment.content %>
                </div>
            </div>

            <!-- Submission Section -->
            <% if (userSubmissions.length> 0) { %>
                <div class="mb-6 rounded-xl bg-emerald-50 border border-emerald-200 p-6">
                    <h2 class="mb-4 text-lg font-bold text-emerald-900">
                        <span class="iconify mr-2 inline-block h-5 w-5" data-icon="ph:check-circle-bold"></span>
                        Your Submissions
                    </h2>
                    <div class="space-y-3">
                        <% userSubmissions.forEach(submission=> { %>
                            <div class="rounded-lg bg-white p-4 shadow-sm">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm text-slate-500">Submitted <%= new
                                                Date(submission.timestamp).toLocaleString() %>
                                        </p>
                                        <% if (submission.score !==null) { %>
                                            <p class="mt-1 text-lg font-bold text-indigo-600">Score: <%=
                                                    submission.score %>/100</p>
                                            <% } else { %>
                                                <p class="mt-1 text-sm text-amber-600 font-medium">⏳ Pending review</p>
                                                <% } %>
                                    </div>
                                    <a href="/submission/<%= submission.id %>"
                                        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition-all hover:bg-indigo-700 active:scale-95">
                                        View Submission
                                    </a>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>

                        <!-- Leaderboard Section -->
                        <% if (leaderboard && leaderboard.length> 0) { %>
                            <div
                                class="mb-6 rounded-xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 p-6">
                                <h2 class="mb-4 text-lg font-bold text-amber-900">
                                    <span class="iconify mr-2 inline-block h-5 w-5" data-icon="ph:trophy-bold"></span>
                                    Leaderboard - Top Performers
                                </h2>
                                <div class="space-y-2">
                                    <% leaderboard.forEach((entry, index)=> { %>
                                        <div
                                            class="rounded-lg <%= entry.isCurrentUser ? 'bg-gradient-to-r from-indigo-100 to-purple-100 border-2 border-indigo-300' : 'bg-white' %> p-4 shadow-sm transition-all hover:shadow-md">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-4">
                                                    <!-- Rank Badge -->
                                                    <div
                                                        class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full <%= index === 0 ? 'bg-amber-400 text-white' : index === 1 ? 'bg-slate-300 text-slate-700' : index === 2 ? 'bg-orange-300 text-white' : 'bg-slate-100 text-slate-600' %> font-bold">
                                                        <% if (index < 3) { %>
                                                            <span class="iconify h-5 w-5"
                                                                data-icon="<%= index === 0 ? 'ph:crown-fill' : index === 1 ? 'ph:medal-fill' : 'ph:medal-fill' %>"></span>
                                                            <% } else { %>
                                                                #<%= index + 1 %>
                                                                    <% } %>
                                                    </div>

                                                    <!-- Student Info -->
                                                    <div>
                                                        <p class="font-semibold text-slate-900">
                                                            <%= entry.author %>
                                                                <% if (entry.isCurrentUser) { %>
                                                                    <span
                                                                        class="ml-2 inline-flex items-center gap-1 rounded-full bg-indigo-600 px-2 py-0.5 text-xs font-bold text-white">
                                                                        <span class="iconify h-3 w-3"
                                                                            data-icon="ph:user-bold"></span>
                                                                        You
                                                                    </span>
                                                                    <% } %>
                                                        </p>
                                                        <% if (user.role==='teacher' && entry.email) { %>
                                                            <p class="text-xs text-slate-500">
                                                                <%= entry.email %>
                                                            </p>
                                                            <% } %>
                                                                <p class="text-xs text-slate-500">
                                                                    <span class="iconify mr-1 inline-block h-3 w-3"
                                                                        data-icon="ph:clock-bold"></span>
                                                                    <%= new Date(entry.timestamp).toLocaleDateString()
                                                                        %>
                                                                </p>
                                                    </div>
                                                </div>

                                                <!-- Score Display -->
                                                <div class="text-right">
                                                    <p
                                                        class="text-2xl font-bold <%= entry.score >= 90 ? 'text-emerald-600' : entry.score >= 80 ? 'text-blue-600' : entry.score >= 70 ? 'text-amber-600' : 'text-slate-600' %>">
                                                        <%= entry.score %>
                                                    </p>
                                                    <p class="text-xs text-slate-500">/ 100</p>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>

                                <% if (leaderboard.length===10) { %>
                                    <p class="mt-4 text-center text-xs text-amber-700">
                                        <span class="iconify mr-1 inline-block h-3 w-3" data-icon="ph:info-bold"></span>
                                        Showing top 10 submissions
                                    </p>
                                    <% } %>
                            </div>
                            <% } %>

                                <!-- Submit New Solution Form -->
                                <div
                                    class="rounded-xl bg-gradient-to-br from-indigo-50 to-purple-50 border border-indigo-200 p-6">
                                    <h2 class="mb-4 text-lg font-bold text-indigo-900">
                                        <span class="iconify mr-2 inline-block h-5 w-5"
                                            data-icon="ph:paper-plane-right-bold"></span>
                                        Submit Your Solution
                                    </h2>
                                    <form action="/submit" method="POST">
                                        <input type="hidden" name="assignmentId" value="<%= assignment.id %>">
                                        <textarea name="content"
                                            placeholder="Write your solution here... (You can use HTML tags like img, p, strong, etc.)"
                                            class="mb-4 block w-full rounded-xl border border-indigo-200 bg-white p-4 text-base text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all"
                                            rows="6" required></textarea>
                                        <button type="submit"
                                            class="w-full rounded-xl bg-indigo-600 px-6 py-3 font-bold text-white shadow-lg shadow-indigo-600/20 transition-all hover:bg-indigo-700 active:scale-95">
                                            <span class="iconify mr-2 inline-block h-5 w-5"
                                                data-icon="ph:upload-bold"></span>
                                            Submit Assignment
                                        </button>
                                    </form>
                                </div>
                </div>
        </div>
    </div>