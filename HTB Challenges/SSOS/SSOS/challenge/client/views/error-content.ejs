<div class="flex min-h-[60vh] items-center justify-center">
    <div class="w-full max-w-md animate-fade-in">
        <div class="overflow-hidden rounded-2xl bg-white shadow-card sm:rounded-3xl">
            <div class="border-b border-slate-100 bg-rose-50 p-6">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                    <span class="iconify h-8 w-8" data-icon="ph:x-circle-bold"></span>
                </div>
                <h1 class="text-center text-2xl font-bold text-slate-900">Oops! Something went wrong</h1>
            </div>
            
            <div class="p-8 text-center">
                <div class="mb-6 rounded-xl bg-slate-50 p-4">
                    <p class="text-slate-700"><%= message %></p>
                </div>
                
                <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 font-bold text-white shadow-lg shadow-indigo-600/20 transition-all hover:bg-indigo-700 active:scale-95">
                    <span class="iconify h-5 w-5" data-icon="ph:house-bold"></span>
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</div> 