{{ define "home.tmpl" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSO Service - Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
    <nav class="bg-white shadow-lg">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-center">
                <div class="flex space-x-7">
                    <div>
                        <a href="/" class="flex items-center py-4">
                            <span class="font-semibold text-gray-500 text-lg">SSO Service</span>
                        </a>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    {{ if .user }}
                        <span class="text-gray-700">Welcome, {{ .user.Name }}</span>
                    {{ else }}
                        <a href="/login" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                            Login
                        </a>
                        <a href="/register" class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
                            Register
                        </a>
                    {{ end }}
                </div>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        {{ if .user }}
            <div class="max-w-4xl mx-auto">
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="px-6 py-8">
                        <h2 class="text-2xl font-bold text-gray-700 mb-6">Your Account</h2>
                        <div class="space-y-4">
                            <div class="flex items-center border-b border-gray-200 pb-4">
                                <span class="font-semibold text-gray-600 w-32">Name:</span>
                                <span class="text-gray-800">{{ .user.Name }}</span>
                            </div>
                            <div class="flex items-center border-b border-gray-200 pb-4">
                                <span class="font-semibold text-gray-600 w-32">Email:</span>
                                <span class="text-gray-800">{{ .user.Email }}</span>
                            </div>
                        </div>

                        <!-- <div class="mt-8">
                            <h3 class="text-xl font-bold text-gray-700 mb-4">Connected Applications</h3>
                            {{ if .authorizedApps }}
                                <div class="space-y-4">
                                    {{ range .authorizedApps }}
                                        <div class="flex items-center justify-between border-b border-gray-200 pb-4">
                                            <div>
                                                <h4 class="font-semibold text-gray-800">{{ .Name }}</h4>
                                                <p class="text-sm text-gray-600">Authorized on: {{ .AuthorizedAt }}</p>
                                            </div>
                                        </div>
                                    {{ end }}
                                </div>
                            {{ else }}
                                <p class="text-gray-600">No applications connected yet.</p>
                            {{ end }}
                        </div> -->
                    </div>
                </div>
            </div>
        {{ end }}
    </div>

    <script>
    {{ if .user }}
    {{ end }}
    </script>
</body>
</html>
{{ end }}
